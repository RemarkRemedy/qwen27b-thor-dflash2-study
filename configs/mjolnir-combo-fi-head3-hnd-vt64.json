[
  "docker",
  "run",
  "--name",
  "quasar-mjolnir-combo-fi-head3-hnd-vt64-20261025",
  "--no-healthcheck",
  "--cpus",
  "4",
  "--cpu-shares",
  "128",
  "--memory",
  "48g",
  "--memory-swap",
  "48g",
  "--pids-limit",
  "1024",
  "--shm-size",
  "256m",
  "--device",
  "nvidia.com/gpu={GPU_UUID}",
  "-p",
  "127.0.0.1:18081:8000",
  "-e",
  "CUDA_VISIBLE_DEVICES={GPU_UUID}",
  "-e",
  "NVIDIA_VISIBLE_DEVICES={GPU_UUID}",
  "-e",
  "TORCH_CUDA_ARCH_LIST=11.0a",
  "-e",
  "FLASHINFER_CUDA_ARCH_LIST=11.0a",
  "-e",
  "TRITON_PTXAS_PATH=/usr/local/cuda/bin/ptxas",
  "-e",
  "MAX_JOBS=1",
  "-e",
  "HF_HUB_OFFLINE=1",
  "-e",
  "TRANSFORMERS_OFFLINE=1",
  "-v",
  "{TARGET_DIR}:/model:ro",
  "-v",
  "{CACHE_DIR}:/root/.cache",
  "-v",
  "{ARCHIVED_WEIGHT_UTILS}:/usr/local/lib/python3.12/dist-packages/vllm/model_executor/model_loader/weight_utils.py:ro",
  "-v",
  "{REPO_DIR}/scripts/launch.py:/launch.py:ro",
  "--entrypoint",
  "python3",
  "-e",
  "VLLM_KV_CACHE_LAYOUT=HND",
  "-e",
  "MJOLNIR_ATTN_FALLBACK=FLASHINFER",
  "-v",
  "{MJOLNIR_DIR}/docker/vllm-thor/kernel_test_fi_update.py:/kernel_test_fi_update.py:ro",
  "-v",
  "{ARCHIVED_MTP_VOCAB}:/draft_vocab.json:ro",
  "-e",
  "MJOLNIR_DRAFT_VOCAB=/draft_vocab.json",
  "-e",
  "MJOLNIR_DRAFT_VOCAB_SIZE=65536",
  "-e",
  "MJOLNIR_LM_HEAD=fp8",
  "{IMAGE}",
  "/launch.py",
  "/model",
  "--served-model-name",
  "qwen27-test",
  "--host",
  "0.0.0.0",
  "--port",
  "8000",
  "--max-model-len",
  "4096",
  "--max-num-seqs",
  "1",
  "--max-num-batched-tokens",
  "4096",
  "--gpu-memory-utilization",
  "0.32",
  "--kv-cache-memory-bytes",
  "2147483648",
  "--kv-cache-dtype",
  "fp8",
  "--attention-backend",
  "MJOLNIR",
  "--language-model-only",
  "--enable-prefix-caching",
  "--enable-chunked-prefill",
  "--generation-config",
  "vllm",
  "--speculative-config",
  "{\"method\": \"mtp\", \"num_speculative_tokens\": 3}"
]
