[
  "docker",
  "run",
  "--name",
  "quasar-mjolnir-dflash2-chisel-bf16-7-hnd-kv3-20261025",
  "--no-healthcheck",
  "--cpus",
  "4",
  "--cpu-shares",
  "128",
  "--memory",
  "48g",
  "--memory-swap",
  "48g",
  "--pids-limit",
  "1024",
  "--shm-size",
  "256m",
  "--device",
  "nvidia.com/gpu={GPU_UUID}",
  "-p",
  "127.0.0.1:18081:8000",
  "-e",
  "CUDA_VISIBLE_DEVICES={GPU_UUID}",
  "-e",
  "NVIDIA_VISIBLE_DEVICES={GPU_UUID}",
  "-e",
  "TORCH_CUDA_ARCH_LIST=11.0a",
  "-e",
  "FLASHINFER_CUDA_ARCH_LIST=11.0a",
  "-e",
  "TRITON_PTXAS_PATH=/usr/local/cuda/bin/ptxas",
  "-e",
  "MAX_JOBS=1",
  "-e",
  "HF_HUB_OFFLINE=1",
  "-e",
  "TRANSFORMERS_OFFLINE=1",
  "-v",
  "{TARGET_DIR}:/model:ro",
  "-v",
  "{CACHE_DIR}:/root/.cache",
  "-v",
  "{REPO_DIR}/scripts/launch.py:/launch.py:ro",
  "--entrypoint",
  "python3",
  "-v",
  "{DRAFTER_DIR}:/drafter:ro",
  "-e",
  "VLLM_KV_CACHE_LAYOUT=HND",
  "-e",
  "MJOLNIR_ATTN_FALLBACK=FLASHINFER",
  "-v",
  "{MJOLNIR_DIR}/docker/vllm-thor/kernel_test_fi_update.py:/kernel_test_fi_update.py:ro",
  "-v",
  "{REPO_DIR}/chisel:/opt/chisel:ro",
  "-e",
  "PYTHONPATH=/opt/chisel",
  "-e",
  "CHISEL_THOR_FP8=0",
  "{IMAGE}",
  "/launch.py",
  "/model",
  "--served-model-name",
  "qwen27-test",
  "--host",
  "0.0.0.0",
  "--port",
  "8000",
  "--max-model-len",
  "4096",
  "--max-num-seqs",
  "1",
  "--max-num-batched-tokens",
  "4096",
  "--gpu-memory-utilization",
  "0.32",
  "--kv-cache-memory-bytes",
  "3221225472",
  "--kv-cache-dtype",
  "fp8",
  "--attention-backend",
  "MJOLNIR",
  "--language-model-only",
  "--enable-prefix-caching",
  "--enable-chunked-prefill",
  "--generation-config",
  "vllm",
  "--speculative-config",
  "{\"method\": \"dflash\", \"model\": \"/drafter\", \"num_speculative_tokens\": 7, \"attention_backend\": \"FLASHINFER\", \"kv_cache_dtype\": \"auto\"}",
  "--additional-config",
  "{\"chisel_draft_vocab\": \"/opt/chisel/qwen3.8-27b-100k.txt\"}"
]
